#!/usr/bin/env sh

set -e
set -a

export DOTFILES_ROOT="$HOME/.dotfiles"

if [ ! -d "$DOTFILES_ROOT" ]; then
	printf "\033[31mDotfiles not found at %s. Run install.sh first.\033[0m\n" "$DOTFILES_ROOT" >&2
	exit 1
fi

# Source shared variables and helpers
. "$DOTFILES_ROOT/variables.sh"
. "$DOTFILES_ROOT/utils.sh"

COMMAND=$1
CURRENT_DIR=$(pwd)

# Print the title at the start of any command (once, not again after restarting below)
if [ -z "$DOTFILES_RESTARTED" ]; then
	printf "\n%b⚙️  Dotfiles%b\n\n" "$BOLD" "$RESET"
fi

if [ "$COMMAND" = "install" ] || [ "$COMMAND" = "update" ]; then
	# Pull first, then hand over to the freshly pulled install.sh, so install and
	# update always run the latest scripts (the same path as the curl installer)
	if [ -z "$DOTFILES_PULLED" ]; then
		pull_repo || log "error" "Continuing with the current version."
		DOTFILES_PULLED=1 DOTFILES_RESTARTED=1 exec sh "$DOTFILES_ROOT/install.sh" "$@"
	fi

	missing_folders=$(missing_user_folders | tr '\n' ' ')
	current_git_user=$(git_user_summary)

	if [ "$2" = "-y" ]; then
		create_user_folders=y
		update_macos_defaults=y
		setup_git_user=n
		link_gpg_agent=y
		backup_gpg_agent=y
		setup_podman_answer=y
		setup_ai_answer=y
		set_default_shell=y
	else
		create_user_folders=n
		update_macos_defaults=n
		set_default_shell=n
		# User folders and macOS defaults only apply on macOS
		if [ "$(uname)" = "Darwin" ]; then
			if [ -n "$missing_folders" ]; then
				create_user_folders=$(ask "Create missing user folders (${missing_folders% })?")
			fi
			changed_defaults=$(changed_macos_defaults | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')
			if [ -n "$changed_defaults" ]; then
				update_macos_defaults=$(ask "Update macOS defaults ($changed_defaults)?")
			fi
		elif ! zsh_is_default_shell; then
			set_default_shell=$(ask "Make zsh your default shell?")
		fi
		if [ -n "$current_git_user" ]; then
			setup_git_user=$(ask_no "Git user is $current_git_user. Edit it?")
		else
			setup_git_user=$(ask "Configure Git user (name and email)?")
		fi
		link_gpg_agent=$(ask "Set up GPG (agent config and commit signing key)?")
		setup_podman_answer=n
		if ! podman_ready; then
			setup_podman_answer=$(ask "Set up Podman and make the docker command use it?")
		fi
		# On macOS the AI tools come from the Brewfile, so only ask on Linux
		setup_ai_answer=n
		missing_ai=$(missing_ai_tools)
		if [ "$(uname)" != "Darwin" ] && [ -n "$missing_ai" ]; then
			setup_ai_answer=$(ask "Install AI coding tools (${missing_ai% })?")
		fi
	fi

	log "info" "Setting up dotfiles..."

	# Linux: zsh, git and curl are needed by everything below
	if ! ensure_base_packages; then
		exit 1
	fi

	if [ "$set_default_shell" = "y" ] && [ "$(uname)" != "Darwin" ] && ! zsh_is_default_shell; then
		set_zsh_default_shell
	fi

	if [ "$setup_git_user" = "y" ]; then
		configure_git_user
	fi

	if [ ! -f "$DOTFILES_ROOT/.zshrc.user.sh" ]; then
		log "info" "Creating .zshrc.user.sh file"
		touch "$DOTFILES_ROOT/.zshrc.user.sh"
	fi

	chmod +x "$DOTFILES_ROOT/.zshrc.user.sh"

	if [ ! -d "$HOME/.oh-my-zsh" ]; then
		log "info" "Installing Oh My Zsh!"
		sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
	fi

	link_all

	if [ "$(uname)" = "Darwin" ]; then
		if [ "$create_user_folders" = "y" ]; then
			user_folders
		fi
		if [ "$update_macos_defaults" = "y" ]; then
			macos_defaults
		fi
		load_brew || true
		if command -v brew >/dev/null 2>&1; then
			log "info" "Updating Homebrew"
			brew update
			if brew bundle --file="$DOTFILES_ROOT/Brewfile" --quiet --upgrade; then
				log "success" "Homebrew updated with all packages"
			else
				log "error" "Some Homebrew packages failed to install, see above. Fix the Brewfile and run 'dotfiles bundle'."
			fi
			brew cleanup
		else
			log "info" "Installing Homebrew"
			if ! /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || ! load_brew; then
				log "error" "Homebrew installation failed"
			else
				log "success" "Homebrew installed"
				if ! brew bundle --file="$DOTFILES_ROOT/Brewfile" --quiet; then
					log "error" "Some Homebrew packages failed to install, see above. Fix the Brewfile and run 'dotfiles bundle'."
				fi
			fi
		fi
	fi

	setup_node || log "error" "Node setup didn't finish, see above. Run 'dotfiles node' to retry."

	if [ "$setup_ai_answer" = "y" ] && [ "$(uname)" != "Darwin" ]; then
		setup_ai_tools || true
	fi

	if [ "$setup_podman_answer" = "y" ] && ! podman_ready; then
		setup_podman || log "error" "Podman setup didn't finish, see above. Run 'dotfiles podman' to retry."
	fi

	if [ "$link_gpg_agent" = "y" ]; then
		mkdir -p "$HOME/.gnupg"
		chmod 700 "$HOME/.gnupg"
		if [ -f "$HOME/.gnupg/gpg-agent.conf" ] && [ ! -L "$HOME/.gnupg/gpg-agent.conf" ]; then
			if [ -z "$backup_gpg_agent" ]; then
				backup_gpg_agent=$(ask "gpg-agent.conf already exists. Back it up?")
			fi
			if [ "$backup_gpg_agent" = "y" ]; then
				log "info" "Backing up existing gpg-agent.conf"
				mv "$HOME/.gnupg/gpg-agent.conf" "$HOME/.gnupg/gpg-agent.conf.$(date "+%Y%m%d%H%M%S").bak"
				log "success" "gpg-agent.conf backed up successfully."
			else
				log "info" "Keeping existing gpg-agent.conf."
			fi
		fi
		if [ ! -e "$HOME/.gnupg/gpg-agent.conf" ] || [ -L "$HOME/.gnupg/gpg-agent.conf" ]; then
			ln -sfv "$DOTFILES_ROOT/gpg-agent.conf" "$HOME/.gnupg/gpg-agent.conf"
			log "success" "gpg-agent.conf linked successfully."
		fi
		# Choosing or creating a key needs input, so it is skipped in non-interactive (-y) mode
		if [ "$2" != "-y" ]; then
			setup_gpg_key
		fi
	fi

	if [ "$COMMAND" = "install" ]; then
		log "success" "Dotfiles installed"
	fi
	if [ "$COMMAND" = "update" ]; then
		log "success" "Dotfiles updated"
	fi

	cd "$CURRENT_DIR" || exit
	exec zsh -l
fi

if [ "$COMMAND" = "link" ]; then
	log "info" "Linking dotfiles..."
	sync_repo
	cd "$CURRENT_DIR" || exit
	log "success" "Dotfiles linked. Run 'reload' or open a new shell to apply."
fi

if [ "$COMMAND" = "bundle" ]; then
	log "info" "Installing Homebrew packages..."
	load_brew
	brew bundle install --file="$DOTFILES_ROOT/Brewfile"
	log "success" "Homebrew packages installed"
fi

if [ "$COMMAND" = "config-user" ]; then
	configure_git_user
	log "success" "Git user settings updated."
fi

if [ "$COMMAND" = "node" ]; then
	setup_node
fi

if [ "$COMMAND" = "ai-tools" ]; then
	setup_ai_tools
fi

if [ "$COMMAND" = "podman" ]; then
	setup_podman
fi

if [ "$COMMAND" = "gpg-key" ]; then
	setup_gpg_key
fi

if [ "$COMMAND" = "help" ] || [ "$COMMAND" = "" ]; then
	log "" "${BOLD}Usage${RESET}"
	log "" "dotfiles [install|link|bundle|update|config-user|gpg-key|node|podman|ai-tools|help]" 1

	log "" "\n${BOLD}Commands${RESET}"
	log "" "${BOLD}install${RESET}      📥 Installs the dotfiles, sets up Oh My Zsh, Homebrew, and applies macOS defaults." 2
	log "" "${BOLD}update${RESET}       🔄 Updates the dotfiles and re-applies configurations, ensuring everything is up-to-date." 2
	log "" "${BOLD}link${RESET}         🔗 Links the dotfiles to your home directory, ensuring all configurations are properly applied." 2
	log "" "${BOLD}bundle${RESET}       🍺 Installs all Homebrew packages listed in the Brewfile." 2
	log "" "${BOLD}config-user${RESET}  🛠️ Sets your Git name and email." 2
	log "" "${BOLD}gpg-key${RESET}      🔑 Picks an existing GPG key or creates a new one for signing commits." 2
	log "" "${BOLD}podman${RESET}       🐳 Installs Podman and makes the docker command use it (macOS, Debian, Fedora)." 2
	log "" "${BOLD}node${RESET}         🟢 Installs the latest Node LTS (via fnm), pnpm (via Corepack) and Bun." 2
	log "" "${BOLD}ai-tools${RESET}     🤖 Installs Claude Code and Codex, plus Cursor and T3 Code on machines with a desktop." 2
	log "" "${BOLD}help${RESET}         ❓ Displays usage information for the dotfiles command." 2

	log "success" "\nEnjoy managing your development environment with Dotfiles!\n"
fi

exit 0
