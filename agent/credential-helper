#!/bin/sh
# Git credential helper that answers github.com with the token for the repository's
# owner. Needs credential.useHttpPath so git sends the repository path.
# Installed into the agent user's ~/.local/bin by 'dotfiles agent-user'.
[ "$1" = "get" ] || exit 0
host=""
path=""
while IFS= read -r line && [ -n "$line" ]; do
	case "$line" in
		host=*) host=${line#host=} ;;
		path=*) path=${line#path=} ;;
	esac
done
[ "$host" = "github.com" ] || exit 0
token=$("$(dirname "$0")/github-token" "${path%%/*}") || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
